@page "/product"

@using ScanCart.Models;
@using ScanCart.Services;

@inject NavigationManager _navigationManager;
@inject ProductService _productService;
@inject LocalStorageService _localStorageService;

<div class="min-h-screen bg-[#a9cfe2] p-6">

    <div class="mx-auto max-w-lg">

        <!-- Back to Home -->
        <button @onclick="GoBack"
           class="inline-flex items-center gap-2 mb-6
            text-heading font-medium
            transition-all duration-200
            hover:-translate-x-1">

            <svg class="w-5 h-5"
                 xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke-width="2"
                 stroke="currentColor">

                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M15 19l-7-7 7-7" />
            </svg>

            Back to Home
        </button>


        <!-- Product Name -->
        <h1 class="mb-5 text-3xl font-bold tracking-tight text-heading">
            @product?.ProductName
        </h1>


        <!-- Product Card -->
        <div class="bg-neutral-primary-soft
            w-full
            border border-default
            rounded-base
            shadow-md
            overflow-hidden
            transition-all duration-200">

            <!-- Product Image -->
            <div class="w-full h-64 flex items-center justify-center p-6">
                <img src="@product?.ImageUrl"
                     alt="Product Image"
                     class="max-w-full max-h-full object-contain" />
            </div>


            <!-- Product Information -->
            <div class="p-6">

                <!-- Brand -->
                <div class="mb-5">
                    <h2 class="mb-2 text-lg font-semibold text-heading">
                        Brand
                    </h2>

                    <p class="text-body">
                        @product?.Brand
                    </p>
                </div>


                <!-- Quantity -->
                <div class="mb-6">
                    <h2 class="mb-2 text-lg font-semibold text-heading">
                        Quantity
                    </h2>

                    <p class="text-2xl font-bold text-heading">
                        @product?.Quantity
                    </p>
                </div>


                <!-- Add to Cart -->
                <button type="button"
                        class="w-full
                    text-white
                    bg-[#0F172A]
                    hover:bg-blue-800
                    focus:ring-4
                    focus:outline-none
                    focus:ring-blue-300
                    font-medium
                    rounded-base
                    text-base
                    px-5
                    py-3
                    text-center
                    transition-all
                    duration-200
                    active:scale-[0.98]">

                    Add to Cart
                </button>

            </div>

        </div>

    </div>

</div>

@code {

    private Models.Product? product;

    protected override void OnInitialized()
    {
        product = _productService.CurrentProduct;
    }

    private async void AddToCart()
    {
        await _localStorageService.SetItemAsync("scannedProducts", "");
    }

    private void GoBack()
    {
        _navigationManager.NavigateTo("/");
    }
}
