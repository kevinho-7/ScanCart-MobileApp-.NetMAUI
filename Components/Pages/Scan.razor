@page "/scan"

@using ScanCart.Services
@inject BarcodeService _barcodeService;

<div class="min-h-screen bg-[#a9cfe2] flex flex-col">

    <div class="flex items-center gap-3 px-5 py-4 bg-[#0F172A] text-white">
        
        <button
                class="p-2 rounded-lg hover:bg-slate-700 active:scale-95 transition-all duration-150">
            ←
        </button>

        <div>
            <h1 class="text-lg font-semibold">
                Scan Product
            </h1>

            <p class="text-xs text-slate-400">
                Scan the product barcode
            </p>
        </div>
    </div>

    <main class="flex-1 flex flex-col items-center justify-center px-5 py-8">

        <div class="w-full max-w-md">

            <div class="relative overflow-hidden rounded-2xl bg-black shadow-xl aspect-[4/3]">

                <!-- Câmera ZXing here -->

                <div class="absolute inset-0 flex items-center justify-center">

                    <div class="w-64 h-32 border-2 border-white/80 rounded-xl"></div>

                </div>

            </div>

            <div class="text-center mt-6">

                <h1 class="text-xl font-bold text-slate-800">
                    Scan the barcode
                </h1>

                <p class="text-sm text-slate-600 mt-2">
                    Position the barcode inside the frame.
                </p>

            </div>

            <button @onclick="StartScanner"
                    class="w-full mt-6 px-5 py-3
                rounded-xl
                bg-[#0F172A]
                text-white font-medium
                shadow-md
                hover:bg-slate-800
                active:scale-[0.98]
                transition-all">

                Start Scanner

            </button>

        </div>

    </main>

</div>


@code {



    private async Task StartScanner()
    {
        await _barcodeService.OpenScannerAsync();   

        // await Task.CompletedTask;
    }   

    private void GoBack()
    {
        // NavigationManager.NavigateTo("/");  
    }
}