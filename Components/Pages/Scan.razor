@page "/scan"

@using ScanCart.Services

@inject NavigationManager _navigationManager;
@inject BarcodeService _barcodeService;
@inject ProductService _productService;

<div class="min-h-screen bg-[#a9cfe2] flex flex-col">

    <!-- Back to Home -->
    <button @onclick="GoBack"
        class="inline-flex items-center gap-2 mb-6
        text-heading font-medium
        transition-all duration-200
        hover:-translate-x-1">

        <svg class="w-5 h-5"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor">

            <path stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 19l-7-7 7-7" />
        </svg>

        Back to Home
    </button>

    <main class="flex-1 flex flex-col items-center justify-center px-5 py-8">

        <div class="w-full max-w-md">

            <div class="relative overflow-hidden rounded-2xl bg-black shadow-xl aspect-[4/3]">

                <!-- Câmera ZXing here -->

                <div class="absolute inset-0 flex items-center justify-center">

                    <div class="w-64 h-32 border-2 border-white/80 rounded-xl"></div>

                </div>

            </div>

            <div class="text-center mt-6">

                <h1 class="text-xl font-bold text-slate-800">
                    Scan the barcode
                </h1>

                <p class="text-sm text-slate-600 mt-2">
                    Position the barcode inside the frame.
                </p>

            </div>

            <button @onclick="GoToProductPage"
                    class="w-full mt-6 px-5 py-3
                rounded-xl
                bg-[#0F172A]
                text-white font-medium
                shadow-md
                hover:bg-slate-800
                active:scale-[0.98]
                transition-all">

                Start Scanner

            </button>

        </div>

    </main>

</div>


@code {

    private async Task GoToProductPage()
    {
        var barcode = await _barcodeService.ScanAsync();

        if (String.IsNullOrWhiteSpace(barcode))
        {
            return;
        }

        var product = await _productService.GetProductAsync(barcode);

        if(product == null)
        {
            return;
        }

        _navigationManager.NavigateTo("/product");
    }

    private void GoBack()
    {
        _navigationManager.NavigateTo("/");  
    }
}